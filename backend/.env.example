# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voicecall_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-min-32-chars-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-min-32-chars-long"
JWT_REFRESH_EXPIRATION="30d"

# File Storage Configuration
STORAGE_DRIVER="local" # Options: local | s3
STORAGE_LOCAL_PATH="./uploads"
STORAGE_PUBLIC_URL="http://localhost:3000/uploads"

# S3 Compatible Storage (for AWS S3, Cloudflare R2, MinIO)
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET_NAME="voicecall-attachments"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Push Notifications (APNs / FCM)
# FCM_SERVER_KEY=""
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_BUNDLE_ID="com.voicecall.app"
